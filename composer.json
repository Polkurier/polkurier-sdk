{
    "name": "polkurier/polkurier-sdk",
    "description": "SDK for handling the web API of Polkurier.pl",
    "license": [
        "proprietary"
    ],
    "version": "2.0.0",
    "require": {
        "php": "~8.4.0||~8.5.0",
        "guzzlehttp/guzzle": "^7.10",
        "monolog/monolog": "^3.10",
        "symfony/serializer": "^7.2",
        "symfony/property-info": "^7.2",
        "symfony/property-access": "^7.2",
        "phpstan/phpdoc-parser": "^2.0",
        "phpdocumentor/reflection-docblock": "^5.4",
        "psr/cache": "^3.0"
    },
    "autoload": {
        "psr-4": {
            "Polkurier\\Webservice\\": "src/"
        }
    },
    "scripts": {
        "serve": [
            "php -S localhost:9005 -t examples/"
        ],
        "test": [
            "phpunit"
        ],
        "analyse": [
            "phpstan analyse"
        ],
        "check": [
            "@analyse",
            "@test"
        ],
        "test:integration": [
            "@php -r \"if (getenv('POLKURIER_API_URL') === false) { fwrite(STDERR, 'Set POLKURIER_API_URL, plus POLKURIER_API_LOGIN and POLKURIER_API_TOKEN for the authenticated methods.' . PHP_EOL); exit(1); }\"",
            "phpunit --group integration"
        ]
    },
    "require-dev": {
        "phpunit/phpunit": "^11.5",
        "phpstan/phpstan": "^2.1"
    },
    "autoload-dev": {
        "psr-4": {
            "Polkurier\\Webservice\\Test\\": "tests/"
        }
    }
}
